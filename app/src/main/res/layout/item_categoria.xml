<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/imgCategoria"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:contentDescription="Imagen de categoría" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvNombreCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre Categoria"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/white"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/tvDescripcionCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripcion Categoria"
            android:textSize="14sp"
            android:background="@android:color/white"
            android:padding="4dp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</LinearLayout>